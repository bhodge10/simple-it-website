    <loc>https://simple-it.us{{ post.url }}</loc>
    <lastmod>{{ post.date | htmlDateString }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {%- endif %}{%- endfor %}

  {%- for post in portalPosts %}
  <url>
